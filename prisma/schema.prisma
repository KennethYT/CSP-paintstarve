// Prisma 7 的 Rust-free client。provider 必須是 prisma-client（不是舊的
// prisma-client-js），且一定要指定 output —— 這是能在 Cloudflare Workers
// 的 workerd runtime 執行的前提，舊的 Rust query engine 在那裡跑不起來。
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 不再接受 schema 裡的 url：CLI 的連線字串移到 prisma.config.ts，
// 執行期的連線則由 lib/prisma.ts 傳入的 driver adapter 負責。
datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
}

enum EnrollmentStatus {
  enrolled
  waitlist
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role?
  createdAt     DateTime
  updatedAt     DateTime
  account       account[]
  session       session[]

  coursesTaught Course[]     @relation("CourseTeacher")
  enrollments   Enrollment[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  teacherId   String
  // 對應 lib/types.ts 的 CourseCategory。值是中文，Prisma enum 識別字不支援，故用 String。
  category    String
  day         Int
  periodIndex Int
  location    String
  description String
  syllabus    String[]
  capacity    Int
  openAt      DateTime
  hot         Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     user         @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([teacherId])
}

model Enrollment {
  id     String           @id @default(cuid())
  status EnrollmentStatus
  // 僅 waitlist 使用，enrolled 為 null
  position  Int?
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一人同一課只能有一筆，併發時的最後防線
  @@unique([courseId, userId])
  @@index([courseId, status])
  @@index([userId])
}
